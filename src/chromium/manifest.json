{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "declarativeNetRequestFeedback",
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "chromium/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PrivaBlock",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/procedural.js",
        "content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/scriptlets-main.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": []
  },
  "homepage_url": "https://github.com/TNFX1/PrivaBlock",
  "commands": {
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_commandPick__"
    },
    "toggle-site": {
      "description": "__MSG_commandToggle__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "redirects/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
